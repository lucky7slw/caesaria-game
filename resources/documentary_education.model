        }
      }

      photography : {
        photo_mode : "full_photo_mode_available"
        educational_use : "capture_screenshots_for_school_projects"
      }

      time_control : {
        time_of_day : "change_time_to_see_how_city_looks"
        seasons : "see_seasonal_variations"
        historical_eras : "jump_between_different_time_periods"
      }
    }

    achievements : {
      learning_badges : {
        earned_by_completing : "complete_tours_earn_badges"
        categories : ["Explorer", "Architect", "Historian", "Archaeologist", "Scholar"]

        examples : {
          "Aspiring Archaeologist" : "complete_5_architecture_tours"
          "Social Historian" : "complete_all_daily_life_tours"
          "Master Scholar" : "complete_all_tours"
        }
      }

      knowledge_tracking : {
        progress : "track_what_you've_learned"
        gaps : "identify_topics_not_yet_explored"
        recommendations : "suggest_next_tours_based_on_interests"
      }
    }
  }

  // ==========================================================================
  // ENCYCLOPEDIA
  // ==========================================================================
  // Comprehensive database of Roman history and culture

  encyclopedia : {

    content_database : {
      entries : {
        count : "500_plus_detailed_encyclopedia_entries"

        categories : {
          people : {
            emperors : "all_roman_emperors_with_biographies"
            famous_figures : "Cicero_Caesar_Virgil_Cleopatra_Spartacus"
            social_classes : "patricians_plebeians_slaves_freedmen"
          }

          places : {
            rome : "detailed_history_of_rome_itself"
            provinces : "all_roman_provinces"
            cities : "major_cities_of_empire"
            buildings : "specific_monuments_and_structures"
          }

          events : {
            battles : "major_battles_and_wars"
            disasters : "great_fire_pompeii_etc"
            reforms : "political_and_social_reforms"
            successions : "emperor_successions_year_of_four_emperors"
          }

          concepts : {
            government : "republic_empire_cursus_honorum"
            society : "familia_clientela_patronage"
            economy : "trade_taxation_currency"
            military : "legions_tactics_equipment"
            religion : "gods_festivals_rituals"
            culture : "art_literature_philosophy"
            technology : "engineering_agriculture_medicine"
            law : "roman_law_twelve_tables"
          }

          daily_life : {
            clothing : "togas_tunics_stolas"
            food : "what_romans_ate_and_drank"
            housing : "insulae_domus_villas"
            family : "marriage_children_slaves"
            work : "occupations_and_trades"
            leisure : "entertainment_games_baths"
          }

          artifacts : {
            objects : "common_objects_tools_utensils"
            art : "sculptures_paintings_mosaics"
            coins : "roman_currency_and_denominations"
            weapons : "gladius_pilum_shields"
          }
        }
      }

      entry_structure : {
        title : "name_of_entry"
        summary : "brief_overview_paragraph"

        detailed_sections : {
          description : "comprehensive_explanation"
          history : "historical_context_and_development"
          significance : "why_it_matters"
          related_entries : "links_to_related_topics"
        }

        media : {
          images : "historical_photos_reconstructions_artwork"
          3d_models : "interactive_3d_models_if_applicable"
          videos : "short_explanatory_videos"
          audio : "pronunciation_guides_for_latin_names"
        }

        sources : {
          primary : "citations_from_ancient_sources"
          secondary : "modern_scholarly_sources"
          further_reading : "books_and_articles_for_deep_dive"
        }

        in_game_connection : {
          link : "how_this_appears_in_game"
          location : "jump_to_location_in_game_if_applicable"
        }
      }
    }

    access : {
      from_game : {
        inspect_mode : "tap_anything_in_game_open_encyclopedia_entry"
        search : "search_bar_for_finding_entries"
        browse : "browse_by_category"
      }

      standalone : {
        app_section : "encyclopedia_accessible_without_entering_game"
        offline : "available_offline"
      }

      integration : {
        tours : "encyclopedia_linked_from_discovery_tours"
        gameplay : "encyclopedia_linked_from_advisor_messages"
      }
    }

    interactivity : {
      bookmarks : "bookmark_favorite_entries"
      notes : "add_personal_notes_to_entries"
      highlights : "highlight_text_in_entries"

      sharing : {
        specific_entry : "share_link_to_specific_entry"
        export : "export_entry_as_pdf_for_school_assignment"
      }

      quizzes : {
        after_reading : "optional_quiz_after_entry"
        mastery : "track_mastery_of_topics"
      }
    }

    updates : {
      living_document : "encyclopedia_updated_with_new_discoveries"
      archaeological : "incorporate_latest_archaeological_findings"
      scholarly : "revise_based_on_latest_scholarship"
    }
  }

  // ==========================================================================
