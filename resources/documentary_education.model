// ============================================================================
// DOCUMENTARY & EDUCATION MODE
// ============================================================================
// Transform CaesarIA into interactive documentary and educational platform
// Learn Roman history, culture, architecture, society through gameplay
// Inspired by: Assassin's Creed Discovery Tours, educational games, documentaries
// Goal: Make learning Roman history engaging and immersive
// ============================================================================

documentary_education : {

  // ==========================================================================
  // DISCOVERY TOUR MODE
  // ==========================================================================
  // Explore Rome without gameplay pressure - pure learning and discovery

  discovery_tour : {

    access : {
      separate_mode : "distinct_mode_from_main_game"
      no_gameplay : "no_resource_management_or_time_pressure"
      no_consequences : "cannot_fail_or_lose"
      free_exploration : "wander_and_learn_at_own_pace"
    }

    guided_tours : {
      curated_experiences : {
        tour_catalog : "library_of_professional_guided_tours"

        categories : {
          daily_life : {
            "A Day in Ancient Rome" : {
              duration : "30_minutes"
              path : "follow_typical_citizen_through_day"
              stops : [
                "Wake at dawn in insula",
                "Visit public latrine and baths",
                "Buy breakfast from thermopolium (snack bar)",
                "Work in workshop or shop",
                "Lunch and siesta",
                "Visit forum for business",
                "Attend games at Colosseum",
                "Dinner and evening entertainment"
              ]
              educational_content : "narration_text_visuals_at_each_stop"
            }

            "Life of a Roman Woman" : {
              perspective : "experience_constraints_and_roles"
              topics : ["marriage", "motherhood", "property_rights", "limited_public_life"]
            }

            "Childhood in Rome" : {
              perspective : "roman_child's_life"
              topics : ["education", "play", "coming_of_age_ceremonies"]
            }
          }

          architecture : {
            "Wonders of Roman Engineering" : {
              duration : "45_minutes"
              monuments : ["Pantheon", "Colosseum", "Aqueducts", "Circus_Maximus", "Baths_of_Caracalla"]
              technical : "how_they_were_built"
            }

            "The Roman House" : {
              explore : "domus_and_villa_architecture"
              rooms : "atrium_peristyle_triclinium_cubiculum"
              decoration : "frescoes_mosaics_furniture"
            }

            "Public Spaces" : {
              locations : ["forum", "basilica", "temples", "markets"]
              functions : "how_romans_used_these_spaces"
            }
          }

          religion_mythology : {
            "Gods and Goddesses" : {
              temples : "visit_temples_to_each_major_deity"
              rituals : "see_priests_performing_rites"
              festivals : "experience_major_religious_festivals"
            }

            "Mystery Cults" : {
              secret_religions : "Mithraism_Isis_worship_Christianity_early"
              underground : "visit_underground_temples_and_catacombs"
            }
          }

          entertainment : {
            "Bread and Circuses" : {
              games : "gladiatorial_combat_chariot_racing_theater"
              politics : "how_entertainment_controlled_masses"
            }

            "Roman Baths" : {
              experience : "full_bathing_sequence"
              social : "baths_as_social_center"
            }
          }

          military : {
            "The Roman Legion" : {
              training : "gladius_training_formations"
              tactics : "battle_strategies"
              camp : "life_in_military_camp"
            }

            "Conquest and Empire" : {
              expansion : "how_rome_conquered_mediterranean"
              occupation : "ruling_conquered_territories"
            }
          }

          politics : {
            "The Roman Republic" : {
              government : "senate_consuls_tribunes_assemblies"
              elections : "how_elections_worked"
              corruption : "bribery_and_political_machines"
            }

            "The Roman Empire" : {
              emperors : "transition_from_republic_to_empire"
              augustus : "first_emperor_and_his_reforms"
              succession : "problems_of_imperial_succession"
            }
          }

          economy : {
            "Trade and Commerce" : {
              routes : "silk_road_mediterranean_trade"
              goods : "what_was_traded"
              currency : "roman_money_system"
            }

            "Slavery in Rome" : {
              educational : "unflinching_look_at_slavery"
              sources : "how_people_became_enslaved"
              impact : "economic_and_social_impact"
              note : "presented_historically_not_glorified"
            }
          }

          science_technology : {
            "Roman Innovation" : {
              concrete : "revolutionary_building_material"
              aqueducts : "water_engineering"
              roads : "transportation_infrastructure"
              medicine : "medical_knowledge"
            }
          }

          culture : {
            "Art and Literature" : {
              authors : "Virgil_Ovid_Cicero_Horace"
              art : "sculpture_painting_mosaics"
            }

            "Food and Dining" : {
              ingredients : "what_romans_ate"
              garum : "fish_sauce_ubiquitous_condiment"
              banquets : "elaborate_dinner_parties"
            }
          }

          decline : {
            "Fall of Rome" : {
              factors : "political_economic_military_causes"
              timeline : "crisis_of_third_century_to_476_AD"
              legacy : "what_survived"
            }
          }
        }
      }

      tour_structure : {
        waypoints : {
          automatic : "camera_automatically_moves_to_next_stop"
          manual : "or_player_manually_proceeds"
          pause_anytime : "pause_tour_to_explore_freely"
        }

        content_at_stops : {
          narration : {
            voiceover : "professional_voice_actor_narration"
            text : "subtitles_for_accessibility"
            language : "multiple_languages_available"
          }

          visuals : {
            highlight : "highlight_relevant_features"
            animations : "animated_explanations_of_processes"
            comparisons : "before_after_or_cutaway_views"
          }

          information_panels : {
            text : "detailed_text_information"
            images : "historical_images_and_reconstructions"
            maps : "maps_showing_context"
            timelines : "timelines_of_events"
          }

          interactions : {
            questions : "quiz_questions_to_test_understanding"
            choices : "choose_topics_for_deeper_dive"
            activities : "hands_on_activities_like_mosaic_making"
          }
        }

        pacing : {
          estimated_duration : "tours_range_15_minutes_to_2_hours"
          skip_ahead : "skip_to_next_section"
          repeat : "replay_section"
          save_progress : "save_and_resume_later"
        }
      }

      custom_tours : {
        create_own : {
          tools : "players_can_create_custom_tours"
          waypoints : "set_camera_positions_and_waypoints"
          narration : "record_own_narration_or_use_text_to_speech"
          annotations : "add_text_labels_and_information"
        }

        share : {
          community : "share_custom_tours_with_community"
          education : "teachers_create_tours_for_students"
        }

        curated : {
          featured : "best_custom_tours_featured_officially"
          verified : "tours_verified_for_historical_accuracy"
        }
      }
    }

    free_exploration : {
      wander_mode : {
        no_constraints : "explore_city_with_no_guidance"
        first_person : "optional_first_person_perspective"

        interactions : {
          citizens : "talk_to_citizens_learn_about_them"
          buildings : "enter_buildings_explore_interiors"
          objects : "examine_objects_for_information"
        }

        information_popups : {
          contextual : "tap_anything_to_learn_about_it"
