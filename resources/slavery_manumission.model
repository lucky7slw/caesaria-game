// CaesarIA 2025 - Slavery & Manumission System
// Historically accurate portrayal of Roman slavery with educational context
// Not glorifying - showing the brutal reality and path to freedom

slavery_system : {
  // ==========================================
  // EDUCATIONAL DISCLAIMER
  // ==========================================
  disclaimer : {
    purpose : "historical_accuracy_and_education"

    statements : {
      not_endorsing : "This system portrays historical slavery to educate about ancient Rome. It does not endorse or glorify slavery in any form."

      brutal_reality : "Roman slavery was fundamentally inhumane - treating human beings as property. This system shows that reality."

      historical_context : "30-40% of Rome's population were enslaved. Understanding this is essential to understanding Roman society."

      moral_choices : "Players can choose humane treatment. The game rewards compassion and manumission."

      modern_slavery : "Modern slavery still exists. Learn more at endslaverynow.org"
    }

    toggle : "players_can_disable_this_system_entirely"
  }

