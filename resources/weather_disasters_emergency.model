        building_resilience : {
          roman_engineering : {
            concrete : "flexible_absorbs_shocks_better"
            arches : "distribute_forces_more_stable"
            quality : "higher_quality_construction_survives_better"
          }

          building_codes : {
            player_option : "invest_in_earthquake_resistant_construction"
            cost : "20_percent_higher_building_costs"
            benefit : "significantly_reduced_damage"
          }
