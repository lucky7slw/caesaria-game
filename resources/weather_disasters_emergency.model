        secondary_effects : {
          fires : "braziers_lamps_overturned_start_fires"
          landslides : "in_mountainous_regions"
          tsunamis : "if_epicenter_under_sea"
          panic : "stampedes_looting_social_breakdown"
        }
      }

      gameplay : {
        random_occurrence : {
          base_probability : "depends_on_region"
