          }
          vulturnus : {
            name : "East wind"
            season : "autumn"
            character : "variable_unpredictable"
          }
        }
      }

      humidity : {
        range : "30_to_90_percent"
        effects : {
          high_humidity : {
            summer : "oppressive_heat_morale_penalty"
            winter : "feels_colder_than_actual_temperature"
            health : "disease_spreads_faster"
          }
          low_humidity : {
            summer : "more_bearable_heat"
            fire_risk : "increased"
            health : "dehydration_risk"
          }
        }
      }
