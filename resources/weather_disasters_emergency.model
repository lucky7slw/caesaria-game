  // ==========================================================================
  // NATURAL DISASTERS
  // ==========================================================================
  // Catastrophic events that can devastate cities

  disasters : {

    // ========================================================================
    // EARTHQUAKES - Common in Italy due to tectonic activity
    // ========================================================================

    earthquakes : {
      frequency : {
        minor_tremors : {
          occurrence : "several_per_year"
          magnitude : "1_to_3_richter"
          effects : "barely_noticed_no_damage"
        }

        moderate : {
          occurrence : "every_few_years"
          magnitude : "4_to_5_richter"
          effects : {
            buildings : "cracks_in_walls_fallen_tiles"
            citizens : "panic_flee_buildings"
            casualties : "few_injuries_rare_deaths"
          }
        }

        major : {
          occurrence : "every_decade_or_two"
          magnitude : "6_to_7_richter"
          effects : {
            buildings : {
              poor_quality : "collapse_complete_destruction"
              average_quality : "severe_damage_uninhabitable"
              high_quality : "significant_damage_repairable"
              monuments : "partial_collapse_expensive_repairs"
            }
            infrastructure : {
              roads : "cracked_impassable"
              aqueducts : "broken_water_supply_cut"
              bridges : "collapsed_trade_disrupted"
            }
            casualties : {
              immediate : "hundreds_to_thousands_crushed"
              aftermath : "disease_exposure_starvation"
            }
            economic : "devastating_years_to_recover"
          }
        }

        catastrophic : {
          occurrence : "rare_generational"
          magnitude : "7_plus_richter"
          effects : {
            city : "complete_destruction_total_rebuild_needed"
            death_toll : "majority_of_population"
            economic : "bankruptcy_decades_to_recover"
          }
        }
      }

      famous_historical_earthquakes : {
