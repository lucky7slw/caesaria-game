        recovery : {
          immediate : {
            search_rescue : "find_survivors_in_rubble"
            medical : "treat_injured"
            temporary_shelter : "tents_for_homeless"
          }

          short_term : {
            clear_rubble : "remove_debris_open_roads"
            assess_damage : "structural_surveys"
            emergency_repairs : "shore_up_dangerous_buildings"
          }

          long_term : {
            rebuild : "reconstruct_destroyed_buildings"
            upgrade : "opportunity_to_improve_construction"
            psychological : "restore_citizen_confidence"
          }
        }
      }
