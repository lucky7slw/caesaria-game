// ============================================================================
// DYNAMIC WEATHER, DISASTERS & EMERGENCY SERVICES SYSTEM
// ============================================================================
// A comprehensive environmental and disaster management system for CaesarIA
// Features realistic Roman weather patterns, natural disasters, and emergency response
// Historical accuracy based on: Pliny (Natural History), Tacitus (Annales),
// Seneca (Natural Questions), Suetonius, archaeological evidence
// ============================================================================

weather_disasters_emergency : {

  // ==========================================================================
  // DYNAMIC WEATHER SYSTEM
  // ==========================================================================
  // Real-time weather affecting gameplay, agriculture, construction, morale

  weather : {

    // Mediterranean climate patterns
    climate_system : {
      base_climate : "mediterranean"
      characteristics : {
        hot_dry_summers : {
          months : ["june", "july", "august", "september"]
          temperature : {
            day : "25_to_35_celsius" // 77-95F
            night : "15_to_20_celsius" // 59-68F
          }
          precipitation : "minimal_rare_showers"
          description : "Long dry season with intense sun"
        }

        mild_wet_winters : {
          months : ["december", "january", "february"]
          temperature : {
            day : "10_to_15_celsius" // 50-59F
            night : "5_to_10_celsius" // 41-50F
          }
          precipitation : "frequent_rain_storms"
          description : "Cool rainy season, rare snow in Rome"
        }

        spring : {
          months : ["march", "april", "may"]
          temperature : {
            day : "15_to_25_celsius" // 59-77F
            night : "8_to_15_celsius"
          }
          precipitation : "moderate_spring_showers"
          description : "Pleasant growing season"
        }

        autumn : {
          months : ["october", "november"]
          temperature : {
            day : "18_to_25_celsius" // 64-77F
            night : "10_to_15_celsius"
          }
          precipitation : "increasing_autumn_rains"
          description : "Harvest season before winter"
        }
      }
    }

    // Real-time weather conditions
    current_conditions : {
      temperature : {
        range : "-5_to_40_celsius" // 23-104F extreme range
        update_frequency : "every_hour_game_time"
        variation : {
          day_night_cycle : "temperature_fluctuates"
          seasonal : "follows_climate_patterns"
          microclimate : "city_warmer_than_countryside"
        }
      }

      precipitation : {
        types : {
          clear : {
            probability : "60_percent_annual"
            effects : "normal_operations"
          }

          light_rain : {
            probability : "20_percent"
            effects : {
              construction : "slowed_10_percent"
              morale : "slight_decrease"
              agriculture : "beneficial_for_crops"
              fire_risk : "reduced"
            }
          }

          heavy_rain : {
            probability : "10_percent"
            effects : {
              construction : "stopped"
              roads : "muddy_slow_travel"
              flooding_risk : "increases"
              agriculture : "can_damage_crops_if_prolonged"
            }
            visual : {
              puddles : "form_in_streets"
              citizens : "seek_shelter_use_cloaks"
            }
          }

          thunderstorm : {
            probability : "5_percent"
            effects : {
              all_outdoor_work : "halted"
              lightning_strikes : "can_start_fires"
              morale : "citizens_fearful"
              religious : "priests_perform_rituals_to_jupiter"
            }
            historical_note : "Romans saw lightning as omen from Jupiter"
          }

          snow : {
            probability : "2_percent_winter_only"
            location : "rare_in_rome_common_in_alps"
            effects : {
              construction : "completely_stopped"
              roads : "impassable_until_melt"
              heating : "increased_demand_for_firewood"
              beauty : "snow_covered_city_beautiful"
            }
            historical : {
              pliny : "Describes snow storage in ice houses (nevaria) for cooling drinks"
              nero : "Had snow brought from mountains for banquets"
            }
          }

          hail : {
            probability : "3_percent_spring_summer"
            effects : {
              crops : "can_destroy_entire_harvest"
              buildings : "damage_to_roofs_tiles"
              citizens : "injuries_if_caught_outside"
              economic : "severe_financial_impact"
            }
            historical : "Pliny records devastating hailstorms destroying crops"
          }
        }
      }

      wind : {
        types : {
          calm : {
            speed : "0_to_10_kph"
            effects : "normal_conditions"
          }

          breeze : {
            speed : "10_to_30_kph"
            effects : {
              pleasant : "citizens_enjoy_outdoor_activities"
              sailing : "good_for_trade_ships"
            }
          }

          strong_wind : {
            speed : "30_to_60_kph"
            effects : {
              construction : "crane_work_dangerous"
              fire_risk : "spreads_fires_rapidly"
              market_stalls : "blown_over"
