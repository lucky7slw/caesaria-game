  // ==========================================
  // AGENT TYPES & RECRUITMENT
  // ==========================================
  agents : {
    types : {
      spy : {
        role : "intelligence_gathering"
        skills : ["observation", "memory", "social", "languages"]
        cover : {
          merchant : "travels_widely"
          scholar : "asks_questions"
          servant : "invisible_access"
          entertainer : "welcomed_everywhere"
        }

        missions : {
          surveillance : "watch_targets"
          infiltration : "join_organizations"
          information_theft : "steal_documents"
          contact_recruitment : "find_informants"
        }

        training_duration : "6_months_to_2_years"
        cost : "2000_denarii_per_month"
      }

      scout : {
        role : "military_reconnaissance"
        skills : ["navigation", "survival", "stealth", "memory"]
        equipment : ["fast_horse", "light_armor", "signal_equipment"]

        missions : {
          enemy_positions : "locate_armies"
          terrain_mapping : "scout_routes"
