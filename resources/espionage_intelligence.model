// CaesarIA 2025 - Espionage & Intelligence Network
// Covert operations, spy networks, and secret intelligence gathering

espionage_system : {
  // ==========================================
  // SPY NETWORK STRUCTURE
  // ==========================================
  network : {
    organization : {
      hierarchy : {
        spymaster : {
          role : "player_or_appointed_official"
          responsibilities : ["oversee_all_operations", "analyze_intelligence", "direct_agents"]
          authority : "complete_control"
          secrecy : "identity_hidden"
        }

        handlers : {
          count : "1_per_5_agents"
          role : "manage_field_agents"
          responsibilities : ["assign_missions", "receive_reports", "maintain_cover"]
          compartmentalization : "dont_know_other_handlers"
        }

        field_agents : {
          types : ["spies", "scouts", "infiltrators", "saboteurs", "assassins"]
          count : "varies_by_budget"
          training : "specialized_by_type"
          expendable : "sometimes"
        }

        informants : {
          role : "part_time_sources"
          count : "unlimited"
          reliability : "varies_greatly"
          payment : "per_information"
          identity : "civilians_with_access"
        }

        sleeper_agents : {
          role : "long_term_deep_cover"
          placement : "enemy_cities_governments"
          activation : "only_when_needed"
          risk : "can_be_turned"
        }
      }

      communication : {
        methods : {
          dead_drops : {
            description : "hidden_exchange_locations"
            types : ["hollow_trees", "loose_bricks", "market_stalls", "temples"]
            schedule : "pre_arranged_times"
            security : "avoid_direct_contact"
          }

          couriers : {
            description : "message_runners"
            speed : "fast_horses_or_ships"
            security : {
              sealed_messages : "wax_seals"
              memorization : "destroy_written_copy"
              multiple_routes : "redundancy"
              expendable : "captured_couriers_killed"
            }
          }

          coded_messages : {
            description : "encrypted_communications"
            methods : ["substitution_cipher", "caesar_cipher", "scytale", "steganography"]
            keys : "changed_regularly"
            code_books : "hidden"
          }

          signal : {
            visual : ["smoke", "mirrors", "flags", "lights"]
            audio : ["drums", "horns", "bells"]
            timing : "prearranged_meanings"
            range : "limited"
          }
        }

        safe_houses : {
          location : "throughout_city_and_empire"
          purpose : {
            meetings : "secure_discussions"
            hideouts : "agents_on_run"
            interrogations : "questioning_prisoners"
            storage : "documents_equipment"
          }

          security : {
            multiple_exits : "escape_routes"
            lookouts : "sentries"
            reinforced : "defend_if_discovered"
            discreet : "unremarkable_appearance"
          }

          staff : {
            keeper : "maintains_safe_house"
            guards : "2_to_4"
            servants : "provide_cover_story"
          }
        }
      }

      resources : {
        budget : {
          allocation : {
            salaries : "40_percent"
            bribes : "30_percent"
            equipment : "15_percent"
            operations : "10_percent"
            contingency : "5_percent"
          }

          sources : {
            state_treasury : "official_allocation"
            secret_funds : "hidden_accounts"
            seized_assets : "from_enemies"
            extortion : "blackmail_payments"
          }

          costs : {
            minimal_network : "10000_denarii_per_month"
            standard_network : "50000_denarii_per_month"
            extensive_network : "200000_denarii_per_month"
            empire_wide : "1000000_denarii_per_month"
          }
        }

        equipment : {
          documents : ["forged_papers", "blank_seals", "letter_templates"]
          disguises : ["wigs", "makeup", "clothing", "fake_badges"]
          weapons : ["hidden_daggers", "garrotes", "poison", "crossbows"]
          tools : ["lockpicks", "code_books", "invisible_ink", "listening_devices"]
          transportation : ["fast_horses", "unmarked_carts", "boats"]
        }
      }
