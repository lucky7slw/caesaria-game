        cost : "500_denarii_per_month"
      }

      infiltrator : {
        role : "deep_cover_operations"
        skills : ["acting", "languages", "cultural_knowledge", "patience"]

        placement : {
          government : "become_official"
          military : "join_legion"
          merchant_guild : "establish_business"
          household : "trusted_servant"
        }

        duration : "years_of_service"
        risk : "discovery_means_death"
        value : "priceless_intelligence"

        training_duration : "1_to_3_years"
        cost : "5000_denarii_per_month_plus_cover"
      }

      saboteur : {
        role : "destruction_disruption"
        skills : ["demolition", "arson", "mechanics", "chemistry"]

        targets : {
          infrastructure : ["aqueducts", "bridges", "roads", "walls"]
          military : ["supplies", "weapons", "ships", "siege_engines"]
          economic : ["warehouses", "markets", "workshops", "mines"]
          political : ["records", "treasuries", "monuments"]
        }

        methods : {
          fire : "most_common"
          structural_damage : "weaken_supports"
          contamination : "poison_water_food"
          theft : "steal_critical_items"
        }

        training_duration : "1_year"
        cost : "3000_denarii_per_month"
      }

      assassin : {
        role : "targeted_elimination"
        skills : ["combat", "stealth", "poison", "patience"]

        methods : {
          blade : {
            weapons : ["dagger", "stiletto", "garrote"]
            approach : ["ambush", "disguise", "surprise"]
            escape : "planned_route"
          }

          poison : {
            types : ["hemlock", "nightshade", "arsenic", "snake_venom"]
            delivery : ["food", "drink", "needle", "vapor"]
            timing : "slow_or_fast_acting"
          }

          accident : {
            staged : ["fall", "drowning", "fire", "collapse"]
