            perfect_crime : "no_suspects"
          }

          public : {
            dramatic : "send_message"
            mob : "incite_riot"
            execution_style : "visible_to_all"
            escape : "difficult_or_impossible"
          }
        }

        difficulty : {
          commoner : "easy"
          official : "moderate"
          senator : "hard"
          consul : "very_hard"
          emperor : "near_impossible"
        }

        training_duration : "2_to_5_years"
        cost : "10000_denarii_per_month"
        mission_fee : "50000_to_1000000_denarii"
      }

      codebreaker : {
        role : "cryptanalysis"
        skills : ["mathematics", "languages", "pattern_recognition", "logic"]

        methods : {
          frequency_analysis : "letter_patterns"
          known_plaintext : "guess_content"
          brute_force : "try_all_keys"
          linguistic : "language_structure"
        }

        success_rate : {
          simple_ciphers : "90_percent"
          complex_ciphers : "50_percent"
          unknown_language : "10_percent"
        }

        training_duration : "3_years_minimum"
        cost : "4000_denarii_per_month"
      }

      interrogator : {
        role : "extract_information"
        skills : ["psychology", "intimidation", "torture", "deception"]

        techniques : {
          psychological : {
            good_cop_bad_cop : "alternating_approaches"
            isolation : "break_down_resistance"
            false_promises : "offer_freedom"
            misinformation : "make_them_think_allies_betrayed"
