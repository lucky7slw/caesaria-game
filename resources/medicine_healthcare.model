// CaesarIA 2025 - Medicine & Healthcare System
// Roman medical practices, public health, and disease management

healthcare_system : {
  // ==========================================
  // MEDICAL THEORY
  // ==========================================
  medical_philosophy : {
    four_humors : {
      theory : "basis_of_roman_medicine"
      origin : "hippocratic_and_galenic"

      humors : {
        blood : {
          element : "air"
          qualities : "hot_and_moist"
          organ : "heart"
          season : "spring"
          temperament : "sanguine"
          excess_symptoms : ["fever", "inflammation", "headache"]
          treatment : "bloodletting"
        }

        yellow_bile : {
          element : "fire"
          qualities : "hot_and_dry"
          organ : "liver"
          season : "summer"
          temperament : "choleric"
          excess_symptoms : ["anger", "jaundice", "fever"]
          treatment : "cooling_foods_and_purging"
        }

        black_bile : {
          element : "earth"
          qualities : "cold_and_dry"
          organ : "spleen"
          season : "autumn"
          temperament : "melancholic"
          excess_symptoms : ["depression", "constipation", "dark_urine"]
          treatment : "warming_foods_and_activity"
        }

        phlegm : {
          element : "water"
          qualities : "cold_and_moist"
          organ : "brain_and_lungs"
          season : "winter"
          temperament : "phlegmatic"
          excess_symptoms : ["lethargy", "coughs", "pale_complexion"]
          treatment : "drying_warming_foods"
        }
      }

      balance : {
        health : "equilibrium_of_humors"
        disease : "imbalance"
        diagnosis : "identify_which_humor_excessive_or_deficient"
        treatment : "restore_balance"
      }

      individual_constitution : {
        each_person : "unique_humoral_balance"
        temperament : "personality_from_dominant_humor"
        susceptibility : "prone_to_certain_diseases"
      }
    }

    miasma_theory : {
      belief : "bad_air_causes_disease"
      sources : ["swamps", "rotting_matter", "crowded_places", "battlefields"]

      prevention : {
        ventilation : "fresh_air_essential"
        location : "avoid_swamps_and_low_areas"
        cleanliness : "remove_waste"
        fumigation : "burning_aromatic_substances"
      }

      partially_correct : "correlation_with_sanitation_works"
    }

    divine_influence : {
      gods : {
        aesculapius : {
          greek_name : "Asclepius"
          domain : "healing_and_medicine"
          symbol : "staff_with_serpent"
          temples : "healing_centers"
        }

        apollo : "also_god_of_healing"
        fever_goddess : "febris"
        health_goddess : "salus"
      }

      temple_healing : {
        incubation : "sleep_in_temple"
        dreams : "god_appears_with_cure"
        offerings : "gratitude_for_healing"
        votive_offerings : "body_part_replicas"
      }

      prayer_and_sacrifice : "common_alongside_medicine"
    }
  }

