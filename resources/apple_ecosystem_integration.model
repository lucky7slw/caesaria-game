  // ==========================================================================
  // HANDOFF & CONTINUITY
  // ==========================================================================
  // Seamless transitions between devices

  handoff : {

    device_transitions : {
      iphone_to_ipad : {
        scenario : "playing_on_iphone_during_commute"
        handoff : "arrive_home_pick_up_ipad_continue_instantly"

        mechanism : {
          indicator : "caesaria_icon_appears_in_ipad_dock"
          tap : "tap_to_open_game_exactly_where_left_off"
          instant : "within_1_second_transition"
        }
      }

      ipad_to_iphone : {
        scenario : "playing_on_ipad_need_to_leave"
        handoff : "pick_up_iphone_continue_on_go"

        ui_adaptation : {
          automatic : "ui_adapts_to_smaller_screen"
          context_preserved : "exact_same_view_just_resized"
        }
      }

      mac_to_iphone : {
        note : "if_mac_version_exists_in_future"
        scenario : "working_on_mac_continue_on_iphone"
      }

      watch_to_iphone : {
        scenario : "see_alert_on_watch_tap_to_open_on_iphone"
        context : "opens_to_relevant_screen_not_just_app_launch"
        example : "Fire alert on watch -> tap -> iPhone opens to fire location on map"
      }
    }

    universal_clipboard : {
      copy_paste : {
        feature : "copy_text_on_one_device_paste_on_another"
        use_cases : {
          city_name : "copy_city_name_on_iphone_paste_in_notes_on_mac"
          stats : "copy_statistics_to_share"
          dynasty_info : "copy_family_tree_data"
        }
      }
    }

    continuity_camera : {
      use : "use_iphone_as_camera_for_ipad"
      application : {
        portraits : {
          feature : "take_photo_of_family_use_as_dynasty_portrait"
