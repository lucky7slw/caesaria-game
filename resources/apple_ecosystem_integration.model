        suggestion : "suggests_automating_common_sequences"
      }
    }

    automation_triggers : {
      time_based : {
        scheduled : "run_shortcuts_at_specific_times"
        examples : [
          "Daily login bonus at 9am",
          "Nightly backup at 11pm"
        ]
      }

      location_based : {
        arrive_home : {
          trigger : "when_arrive_home"
          action : "open_game_load_last_save"
        }

        leave_work : {
          trigger : "when_leave_work"
          action : "send_city_status_update_to_carplay"
        }
      }

      event_based : {
        notification_received : {
          trigger : "when_receive_critical_game_notification"
          action : "run_emergency_response_shortcut"
        }

        battery_low : {
          trigger : "when_battery_below_20_percent"
          action : "auto_save_and_lower_graphics_quality"
        }
      }

      focus_mode : {
        work_focus : {
          when_enabled : "mute_non_critical_game_notifications"
          when_disabled : "resume_all_notifications"
        }

        gaming_focus : {
          custom_focus : "create_dedicated_gaming_focus_mode"
          settings : "allow_game_notifications_silence_everything_else"
          dnd_while_gaming : "do_not_disturb_while_playing"
        }
      }
    }

    data_access : {
      read_game_data : {
        available : [
          "current_population",
          "approval_rating",
          "treasury_balance",
          "food_stockpile",
          "active_threats",
          "construction_progress",
          "dynasty_info"
