  // ==========================================================================
  // SHORTCUTS & AUTOMATION
  // ==========================================================================
  // Apple Shortcuts app integration for advanced automation

  shortcuts : {

    predefined_shortcuts : {
      morning_briefing : {
        actions : [
          "Get overnight city status",
          "List new events",
          "Check threats",
          "Report treasury balance",
          "Speak summary"
        ]

        trigger : "run_automatically_at_8am"
      }

      evening_report : {
        actions : [
          "Summarize day's events",
          "Report construction progress",
          "List completed achievements",
          "Save progress to iCloud",
          "Speak summary"
        ]

        trigger : "run_at_bedtime"
      }

      emergency_response : {
        actions : [
          "Check for threats",
          "If fire: dispatch vigiles",
          "If riot: distribute grain",
          "If invasion: mobilize legion",
          "Send notification when resolved"
        ]

        trigger : "run_when_critical_notification_received"
      }

      weekly_dynasty_update : {
        actions : [
          "Generate family tree summary",
          "List births, deaths, marriages",
          "Report heir's development",
          "Create photo album of dynasty portraits",
          "Share via Messages to family group"
        ]

        trigger : "every_sunday_evening"
      }
    }

    custom_shortcuts : {
      building_shortcuts : {
        user_created : "users_can_create_own_shortcuts"

        examples : {
          "Prepare for War" : {
            actions : [
