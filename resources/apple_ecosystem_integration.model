        }

        scanning : {
          documents : "scan_historical_documents_for_reference"
          inspiration : "scan_roman_artifacts_for_custom_content"
        }
      }
    }

    universal_control : {
      note : "ipados_15_plus_feature"

      multi_device_setup : {
        scenario : "ipad_and_mac_side_by_side"
        control : "use_same_mouse_keyboard_across_devices"

        gameplay : {
          main_screen : "game_on_ipad"
          reference : "historical_references_on_mac"
          seamless : "move_cursor_between_devices"
        }
      }
    }
