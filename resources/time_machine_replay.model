// ============================================================================
// TIME MACHINE & REPLAY SYSTEM
// ============================================================================
// Comprehensive replay and time-travel system for reviewing city history
// Inspired by: racing game replays, RTS replays, video editing timelines
// Goal: Let players explore their city's entire history like a time traveler
// ============================================================================

time_machine : {

  // ==========================================================================
  // CORE REPLAY SYSTEM
  // ==========================================================================
  // Recording and playback of entire game session

  recording : {

    automatic_recording : {
      always_on : "continuously_record_everything_that_happens"

      what_is_recorded : {
        city_state : {
          buildings : "all_buildings_positions_types_state"
          citizens : "every_citizen_position_action_state"
          resources : "stockpiles_production_consumption"
          economy : "treasury_income_expenses_transactions"
          population : "births_deaths_migrations"
          events : "fires_riots_invasions_festivals_all_events"
        }

        player_actions : {
          construction : "every_building_placed_or_demolished"
          orders : "all_player_commands_and_decisions"
          camera : "where_player_looked_and_focused"
          pauses : "when_game_was_paused"
        }

        world_state : {
          time_of_day : "lighting_conditions"
          weather : "weather_patterns"
          seasons : "seasonal_changes"
        }

        metadata : {
          timestamps : "exact_game_time_and_real_time"
          snapshots : "periodic_full_state_snapshots"
          key_events : "tagged_important_moments"
        }
      }

      optimization : {
        delta_compression : "only_record_changes_not_full_state"
        periodic_snapshots : "full_snapshot_every_5_minutes_for_quick_seeking"
        selective_detail : "high_detail_near_camera_low_detail_far_away"

        storage : {
          efficient : "highly_compressed_replay_data"
          typical_size : "1_hour_gameplay_approximately_50_to_100_mb"
          cloud_save : "optional_save_replays_to_icloud"
        }
      }

      session_management : {
        continuous : "one_replay_file_per_game_session"
        auto_save : "periodically_save_replay_to_prevent_loss"
        retention : {
          configurable : "keep_replays_for_7_days_30_days_forever"
          auto_delete : "delete_old_replays_to_save_space"
          protect : "mark_important_replays_to_never_delete"
        }
      }
    }

    manual_recording : {
      bookmarks : {
        create : "player_can_manually_mark_important_moments"
        name : "give_descriptive_name_to_bookmark"
        category : ["construction", "disaster", "battle", "achievement", "other"]
        thumbnail : "auto_generate_thumbnail_screenshot"
      }

      highlights : {
        auto_detect : {
          important_events : "ai_detects_and_marks_highlights"
          examples : [
            "Monument completed",
            "Major fire outbreak",
            "Enemy invasion",
            "Population milestone (100k citizens)",
            "Economic crash or boom",
            "Heir born",
            "Emperor died"
          ]
        }

        manual_mark : "player_can_also_manually_mark_highlights"
      }

      clips : {
        extract : "extract_specific_time_range_as_clip"
        duration : "5_seconds_to_10_minutes"
        export : "save_clip_separately_for_sharing"
      }
    }
  }

  // ==========================================================================
  // PLAYBACK CONTROLS
  // ==========================================================================
  // VCR-style controls for navigating through time

  playback : {

    timeline : {
      visualization : {
        scrubber : "horizontal_timeline_showing_entire_game_history"
        current_position : "playhead_indicator"

        tick_marks : {
          hours : "major_tick_every_game_hour"
          days : "day_boundaries_marked"
          years : "year_boundaries_highlighted"
        }

        events_overlay : {
          icons : "icons_on_timeline_for_major_events"
          color_coding : {
            green : "positive_events_achievements"
            yellow : "warnings_minor_problems"
            red : "disasters_catastrophes"
            blue : "construction_completions"
            purple : "political_events"
          }

          hover : "hover_over_event_to_see_details"
          jump : "tap_event_to_jump_to_that_moment"
        }

        resource_graphs : {
          overlay_graphs : {
            population : "population_over_time_graph"
            treasury : "denarii_balance_over_time"
            food : "grain_stockpile_over_time"
            approval : "citizen_approval_over_time"
          }

          correlation : "see_how_events_affected_metrics"
          toggle : "show_hide_specific_graphs"
        }

        thumbnail_preview : {
          scrub : "drag_playhead_see_thumbnail_preview"
          size : "adjustable_thumbnail_size"
          update : "real_time_thumbnail_as_you_scrub"
        }

        zoom : {
          levels : {
            overview : "entire_session_visible"
            hour : "one_hour_view"
            minute : "one_minute_detailed_view"
            second : "frame_by_frame_precision"
          }

          pinch_zoom : "pinch_to_zoom_timeline"
        }
      }

      navigation : {
        seek : {
          drag_playhead : "drag_to_any_point_in_time"
          tap_timeline : "tap_anywhere_to_jump"
          type_time : "enter_specific_time_code_to_jump"
        }

        jump_to : {
          bookmarks : "jump_directly_to_saved_bookmarks"
          events : "jump_to_next_previous_event"
          highlights : "jump_between_highlights_only"
          start_end : "jump_to_beginning_or_end"
        }

        frame_stepping : {
          next_frame : "advance_one_frame_at_a_time"
          previous_frame : "go_back_one_frame"
          frame_rate : "30_or_60_fps_frame_stepping"
        }
      }
    }

    controls : {
      play_pause : {
        play : "play_replay_forward_at_normal_speed"
        pause : "freeze_at_current_moment"
        toggle : "spacebar_or_tap_to_toggle"
      }

      speed_control : {
        speeds : {
          slowmo : ["0.1x", "0.25x", "0.5x"]
          normal : "1x_real_time"
          fast : ["2x", "5x", "10x", "50x", "100x", "1000x"]
          max : "unlimited_as_fast_as_hardware_allows"
        }

        variable_speed : {
          slider : "continuous_speed_slider"
          presets : "quick_buttons_for_common_speeds"
        }

        direction : {
          forward : "play_forward_in_time"
          reverse : "play_backwards_in_time"
          ping_pong : "alternate_forward_and_backward"
        }

        smooth_ramping : {
          acceleration : "smoothly_accelerate_to_target_speed"
          deceleration : "smoothly_decelerate_when_stopping"
        }
      }

      loop : {
        enable : "loop_playback"
        region : {
          in_point : "set_loop_start_point"
          out_point : "set_loop_end_point"
          duration : "loop_a_specific_time_range"
        }

        use_cases : {
          study : "study_specific_event_by_looping"
          presentation : "loop_dramatic_moment_for_showcase"
        }
      }

      step_through : {
        events : {
          next_event : "skip_to_next_significant_event"
          previous_event : "go_back_to_previous_event"
          event_type_filter : "skip_only_specific_event_types"
        }

        time_increments : {
          hour : "skip_forward_backward_by_hour"
          day : "skip_forward_backward_by_day"
          month : "skip_forward_backward_by_month"
          year : "skip_forward_backward_by_year"
        }
      }
    }
  }

  // ==========================================================================
  // CAMERA CONTROLS IN REPLAY
  // ==========================================================================
  // Free camera movement while watching replay

  camera : {

    modes : {
      follow_original : {
        description : "follow_player's_original_camera_movements"
        use : "see_exactly_what_player_saw_during_gameplay"
        smooth : "option_to_smooth_out_jerky_movements"
      }

      free_camera : {
        description : "completely_free_camera_movement"
        controls : "same_as_photo_mode_camera"
        fly_anywhere : "explore_city_from_any_angle_any_time"

        autopilot : {
          orbit : "orbit_around_specific_building_or_citizen"
          path : "define_camera_path_for_cinematic_fly_through"
          tracking : "track_specific_citizen_or_object"
        }
      }

      predefined_views : {
        overview : "high_overhead_view_of_entire_city"
        street_level : "ground_level_citizen_perspective"
        landmark : "views_centered_on_major_monuments"
        event_location : "auto_frame_where_event_is_happening"
      }

      smart_camera : {
        auto_focus : "ai_automatically_frames_interesting_action"
        multi_camera : "multiple_camera_angles_of_same_moment"
        director_mode : "ai_directs_like_movie_director"
      }
    }

    animation : {
      keyframes : {
        set : "set_keyframe_at_current_time_and_camera_position"
        interpolation : "smoothly_animate_between_keyframes"
        types : ["linear", "ease_in", "ease_out", "ease_in_out", "bezier"]
      }

      camera_path : {
        create : "draw_path_for_camera_to_follow"
        speed : "constant_speed_or_variable"
        orientation : "camera_faces_path_or_locks_to_target"
      }

      shake : {
        enable : "add_camera_shake_for_dramatic_effect"
        intensity : "subtle_to_violent"
        triggers : "auto_shake_during_earthquakes_explosions"
      }
    }

    photo_mode_integration : {
      pause_and_photograph : "pause_replay_at_any_moment_enter_photo_mode"
      capture_moment : "capture_perfect_screenshot_from_history"
      use_case : "recreate_epic_moments_you_missed_first_time"
    }
  }

  // ==========================================================================
  // ANALYSIS & STATISTICS
  // ==========================================================================
  // Dive deep into your city's data over time

  analysis : {

    timeline_statistics : {
      population_analytics : {
        graph : "population_growth_over_time"
        breakdown : {
          births_vs_deaths : "birth_and_death_rates"
          immigration_emigration : "migration_patterns"
          demographics : "age_distribution_over_time"
          employment : "employment_rate_over_time"
        }

        correlations : {
          events : "how_events_affected_population"
          policies : "impact_of_player_decisions"
        }
      }

      economic_analytics : {
        treasury : {
          balance_over_time : "denarii_balance_graph"
          income_expenses : "revenue_vs_spending"
          breakdown : "where_money_came_from_and_went_to"
        }

        trade : {
          volume : "trade_volume_over_time"
          routes : "which_routes_most_profitable"
          goods : "what_goods_traded_most"
        }

        wealth_distribution : {
          inequality : "wealth_gap_between_rich_and_poor"
          trends : "how_inequality_changed"
        }
      }

      resource_management : {
        food_supply : {
          stockpile : "grain_reserves_over_time"
          production_vs_consumption : "how_close_to_shortage"
          crises : "identify_when_nearly_starved"
        }

        production_chains : {
          efficiency : "how_efficiently_resources_produced"
          bottlenecks : "identify_production_bottlenecks"
        }
      }

      approval_and_morale : {
        citizen_approval : "approval_rating_over_time"

        factors : {
          breakdown : "what_affected_approval_when"
          positive : "events_that_boosted_morale"
          negative : "events_that_hurt_morale"
        }

        riots_unrest : {
          frequency : "how_often_riots_occurred"
          causes : "what_triggered_unrest"
          resolution : "how_quickly_resolved"
        }
      }

      construction_timeline : {
        buildings_built : "timeline_of_all_construction"
        construction_speed : "how_fast_city_grew"
        demolitions : "what_was_torn_down_when"

        cost_analysis : {
          total_invested : "total_denarii_spent_on_construction"
          roi : "return_on_investment_for_buildings"
        }
      }

      disaster_log : {
        all_disasters : "comprehensive_log_of_all_disasters"
        frequency : "how_often_disasters_struck"
        impact : {
          casualties : "deaths_from_each_disaster"
          economic : "cost_of_each_disaster"
          recovery_time : "how_long_to_recover"
        }

        response_effectiveness : {
          vigiles : "how_effective_fire_response_was"
          preparation : "did_investments_in_prevention_help"
        }
      }

      military_history : {
        battles : "all_battles_fought"
        outcomes : "wins_losses_casualties"
        cost : "cost_of_military_expenditures"
      }
    }

    heatmaps : {
      traffic_heatmap : {
        visualization : "show_where_citizens_walked_most"
        time_range : "heatmap_for_specific_time_period"
        insights : "identify_busy_areas_underused_areas"
      }

      fire_hazard_heatmap : {
        visualization : "areas_most_prone_to_fires"
        historical : "based_on_actual_fire_history"
        predictive : "identify_high_risk_zones"
      }

      economic_activity_heatmap : {
        visualization : "where_most_economic_activity_occurred"
        types : ["trade", "production", "consumption"]
      }

      crime_heatmap : {
        visualization : "where_crimes_occurred"
        patterns : "identify_high_crime_areas"
      }
    }

    comparison : {
      before_after : {
        events : "compare_city_state_before_and_after_major_event"
        examples : ["before_fire_vs_after", "before_aqueduct_vs_after"]
        metrics : "quantify_impact_of_event"
      }

      alternative_timelines : {
        what_if : "compare_actual_timeline_to_hypothetical"
        note : "if_save_states_allow_branching"
      }
    }

    ai_insights : {
      analysis : "ai_analyzes_replay_provides_insights"

      suggestions : {
        missed_opportunities : "You could have built a granary here to prevent the food shortage"
        mistakes : "Raising taxes at this moment caused the riot"
        best_moments : "Your most efficient period was days 45-60"
      }

      lessons_learned : {
        what_worked : "strategies_that_succeeded"
        what_didnt : "strategies_that_failed"
        recommendations : "suggestions_for_next_playthrough"
      }
    }
  }

  // ==========================================================================
