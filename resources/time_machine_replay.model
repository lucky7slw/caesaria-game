      }

      creative_editing : {
        montage : "create_montage_of_highlights"
        compilation : "compile_best_moments_into_one_video"
      }
    }

    freeze_frame : {
      pause : "pause_at_exact_moment"
      explore : "walk_around_frozen_scene_in_3d"
      matrix_effect : "camera_rotates_around_frozen_action"

      details : {
        zoom_in : "examine_tiny_details_at_frozen_moment"
        transparency : "make_buildings_transparent_to_see_inside"
        information : "tap_any_citizen_or_building_for_info_at_that_moment"
      }
    }
  }

