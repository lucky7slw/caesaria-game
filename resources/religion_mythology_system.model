  // ==========================================
  // DIVINE FAVOR SYSTEM
  // ==========================================
  divine_favor : {
    measurement : {
      scale : "-100_to_100"
      per_god : "each_tracked_separately"
      visible : "in_temple_or_religion_screen"

      ranges : {
        enraged : "-100_to_-75"
        angry : "-75_to_-25"
        displeased : "-25_to_0"
        neutral : "0"
        pleased : "0_to_25"
        favored : "25_to_75"
        blessed : "75_to_100"
      }
    }

    factors : {
      positive : {
        temple_quality : "+1_per_day_per_quality_level"
        sacrifices : "+5_per_sacrifice"
        festivals : "+20_per_festival"
        prayers : "+1_per_100_citizens_praying"
        victory_in_domain : "+30_for_mars_after_battle_won"
        adherence_to_principles : "+variable"
      }

      negative : {
        temple_neglect : "-5_per_day_if_poorly_maintained"
        missed_festivals : "-50_per_missed_festival"
        impious_acts : "-20_per_sacrilege"
        defeat_in_domain : "-30_for_mars_after_battle_lost"
        breaking_vows : "-100_major_offense"
      }

      decay : {
        natural : "-1_per_week_toward_neutral"
        represents : "gods_require_constant_attention"
      }
    }

    effects : {
      at_blessed : {
        miracles : "10_percent_chance_per_month"
        blessings : "active"
        mood : "city_happiness_plus_20"
        productivity : "plus_10_percent"
      }

      at_neutral : {
        nothing : "gods_neither_help_nor_hinder"
      }

      at_enraged : {
        curses : "guaranteed_within_month"
        disasters : "50_percent_chance"
        mood : "city_happiness_minus_30"
        productivity : "minus_20_percent"
      }
    }
  }

