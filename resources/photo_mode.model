// ============================================================================
// PROFESSIONAL PHOTO MODE
// ============================================================================
// Advanced photography system for capturing stunning images of ancient Rome
// Inspired by: Ghost of Tsushima, Horizon, Spider-Man, The Last of Us Part II
// Goal: Turn players into virtual photographers of the Roman world
// ============================================================================

photo_mode : {

  // ==========================================================================
  // CAMERA CONTROLS
  // ==========================================================================
  // Professional-grade camera controls for perfect shots

  camera : {

    positioning : {
      free_camera : {
        movement : {
          pan : {
            horizontal : "move_camera_left_right"
            vertical : "move_camera_up_down"
            depth : "move_camera_forward_backward"

            controls : {
              touch : "swipe_to_pan"
              keyboard : "wasd_or_arrow_keys"
              gamepad : "left_stick"
            }

            speed : {
              slow : "precise_positioning_for_detail_shots"
              normal : "standard_speed"
              fast : "quick_repositioning"
              custom : "adjustable_sensitivity_slider"
            }
          }

          rotation : {
            yaw : "rotate_camera_left_right"
            pitch : "tilt_camera_up_down"
            roll : "tilt_horizon_dutch_angle"

            controls : {
              touch : "two_finger_rotate"
              mouse : "drag_to_rotate"
              gamepad : "right_stick"
            }

            snap : {
              horizon_level : "auto_level_horizon"
              cardinal_directions : "snap_to_north_south_east_west"
              rule_of_thirds : "snap_camera_to_rule_of_thirds_positions"
            }
          }

          zoom : {
            range : "ultra_wide_to_extreme_telephoto"
            focal_lengths : {
              ultra_wide : "14mm_equivalent"
              wide : "24mm_equivalent"
              normal : "50mm_equivalent"
              portrait : "85mm_equivalent"
              telephoto : "135mm_equivalent"
              super_telephoto : "300mm_equivalent"
            }

            controls : {
              pinch : "pinch_to_zoom"
              scroll : "scroll_wheel"
              slider : "zoom_slider_ui"
              buttons : "zoom_in_out_buttons"
            }

            smooth_zoom : "cinematic_smooth_zoom_transition"
          }
        }

        collision : {
          clipping : {
            default : "camera_cannot_pass_through_objects"
            toggle_off : "advanced_option_allow_clipping_for_unique_angles"
          }

          transparency : {
            automatic : "walls_become_transparent_when_blocking_view"
            manual : "hide_specific_objects_for_clean_shot"
          }
        }

        bookmarks : {
          save_position : {
            slots : "10_camera_position_bookmarks"
            quick_save : "press_button_to_save_current_position"
            quick_load : "instantly_return_to_saved_position"
            smooth_transition : "animate_between_positions"
          }

          auto_bookmarks : {
            interesting_views : "game_suggests_cinematic_viewpoints"
            landmarks : "bookmarks_for_major_buildings_monuments"
            events : "suggested_angles_for_festivals_battles"
          }
        }
      }

      field_of_view : {
        range : "30_to_120_degrees"
        presets : {
          narrow : "60_degrees_natural_perspective"
          normal : "75_degrees_default"
          wide : "90_degrees_expansive_vista"
          ultra_wide : "110_degrees_dramatic_effect"
        }

        slider : "precise_adjustment"
      }

      aspect_ratio : {
        presets : [
          "16:9 (landscape)",
          "4:3 (classic)",
          "1:1 (square for Instagram)",
          "9:16 (portrait for mobile)",
          "21:9 (ultrawide cinematic)",
          "2.39:1 (anamorphic widescreen)",
          "custom"
        ]

        overlays : "show_crop_guides_for_target_ratio"
      }
    }

    lens_effects : {
      depth_of_field : {
        enable : "toggle_dof_on_off"

        aperture : {
          range : "f/1.4_to_f/22"
          effect : {
            wide_open : "f1.4_very_shallow_dof_creamy_bokeh"
            medium : "f5.6_moderate_dof"
            stopped_down : "f16_deep_dof_everything_sharp"
          }

          slider : "precise_f_stop_adjustment"
        }

        focus : {
          manual : {
            slider : "adjust_focus_distance"
            visualization : "focus_peaking_highlights_in_focus_areas"
            colors : ["red", "green", "blue", "yellow", "white"]
          }

          auto_focus : {
            tap : "tap_subject_to_focus"
            tracking : "focus_follows_moving_subject"
            face_detection : "auto_focus_on_citizen_faces"
          }

          focus_distance : {
            macro : "focus_on_objects_inches_away"
            portrait : "focus_3_to_10_feet_away"
            landscape : "focus_to_infinity"
          }
        }

        bokeh : {
          shape : {
            circular : "realistic_circular_bokeh"
            hexagonal : "hexagonal_lens_aperture_shape"
            octagonal : "octagonal_high_end_lens"
            custom : "heart_star_shaped_bokeh_for_artistic_effect"
          }

          quality : {
            realistic : "physically_accurate_bokeh"
            artistic : "enhanced_smooth_creamy_bokeh"
            extreme : "exaggerated_for_dramatic_effect"
          }

          chromatic_aberration : {
            enable : "color_fringing_in_bokeh_realistic"
            intensity : "subtle_to_pronounced"
          }
        }
      }

      lens_characteristics : {
        distortion : {
          barrel : "bulging_effect_wide_angle_lenses"
          pincushion : "pinching_effect_telephoto_lenses"
          fisheye : "extreme_barrel_distortion_180_degree_view"
          none : "rectilinear_no_distortion"

          slider : "adjust_distortion_amount"
        }

        vignette : {
          enable : "darkening_of_corners"
          intensity : "subtle_to_heavy"
          feather : "soft_gradual_or_hard_edge"
          color : "black_or_custom_color_tint"
        }

        chromatic_aberration : {
          enable : "color_fringing_at_edges"
          intensity : "realistic_subtle_or_artistic_strong"
        }

        lens_flare : {
          enable : "flare_when_sun_in_frame"
          type : {
            anamorphic : "horizontal_blue_streaks"
            classic : "circular_rainbow_rings"
            modern : "minimal_ghosting"
            vintage : "starburst_and_haze"
          }

          intensity : "subtle_to_dramatic"
          color : "white_blue_gold_custom"
        }

        film_grain : {
          enable : "add_texture_vintage_feel"
          intensity : "fine_to_coarse"
          color : "monochrome_or_color_grain"
        }
      }

      tilt_shift : {
        enable : "miniature_diorama_effect"

        focus_plane : {
          position : "adjust_focus_band_position"
          width : "narrow_band_or_wide_band"
          angle : "horizontal_vertical_or_angled"
        }

        blur_intensity : "subtle_to_extreme_blur_outside_focus"

        enhancement : {
          saturation_boost : "vivid_toy_like_colors"
          contrast_increase : "punchy_miniature_look"
        }
      }

      vintage_effects : {
        sepia : "warm_brown_tones_old_photograph"
        black_and_white : "classic_monochrome"
        daguerreotype : "19th_century_photo_style"
        tintype : "dark_vintage_metallic_look"
        autochrome : "early_color_photography_1900s"
      }
    }

    exposure : {
      mode : {
        auto : "automatic_exposure"
        manual : "full_manual_control"
        aperture_priority : "set_aperture_auto_adjust_shutter"
        shutter_priority : "set_shutter_auto_adjust_aperture"
      }

      settings : {
        iso : {
          range : "100_to_6400"
          effect : {
            low_iso : "clean_image_less_sensitive"
            high_iso : "more_sensitive_more_grain_noise"
          }
        }

        shutter_speed : {
          range : "1/8000s_to_30s"
          effect : {
            fast : "freeze_motion_sharp"
            slow : "motion_blur_flowing_water_moving_crowds"
          }

          note : "affects_motion_blur_simulation_in_paused_game"
        }

        exposure_compensation : {
          range : "-3_to_+3_ev"
          use : "brighten_or_darken_image"
        }
      }

      histogram : {
        display : "rgb_histogram_show_exposure_distribution"
        highlight_clipping : "red_overlay_on_overexposed_areas"
        shadow_clipping : "blue_overlay_on_underexposed_areas"
      }

      hdr : {
        enable : "high_dynamic_range_capture"
        bracketing : "capture_multiple_exposures_merge"
        tone_mapping : "realistic_or_artistic_hdr_look"
      }
    }
  }

  // ==========================================================================
  // COMPOSITION TOOLS
  // ==========================================================================
  // Guides and tools to help compose perfect photographs

  composition : {

    grid_overlays : {
      rule_of_thirds : {
        description : "3x3_grid_for_classic_composition"
        use : "place_subjects_on_intersections_for_balance"
      }

      golden_ratio : {
        description : "fibonacci_spiral_and_phi_grid"
        use : "mathematically_pleasing_composition"
      }

      center_cross : {
        description : "crosshairs_in_center"
        use : "center_aligned_symmetric_shots"
      }

      diagonal_lines : {
        description : "diagonal_from_corners"
        use : "dynamic_energetic_composition"
      }

      golden_triangle : {
        description : "triangular_composition_guide"
        use : "lead_eye_through_image"
      }

      custom_grid : {
        rows : "2_to_10_rows"
        columns : "2_to_10_columns"
        use : "custom_architectural_grid"
      }

      display : {
        opacity : "adjustable_0_to_100_percent"
        color : "white_black_yellow_custom"
        toggle : "quick_on_off"
      }
    }

    framing_aids : {
      safe_areas : {
        action_safe : "area_guaranteed_visible_all_screens"
        title_safe : "area_safe_for_text_and_titles"
      }

      aspect_ratio_masks : {
        dim_outside : "darken_area_outside_target_ratio"
        crop_preview : "show_exactly_what_will_be_cropped"
      }

      headroom_guide : {
        portrait : "show_ideal_headroom_for_portraits"
        adjustable : "customize_to_preference"
      }
    }

    smart_suggestions : {
      ai_composition : {
        analysis : "ai_analyzes_scene_suggests_improvements"
        suggestions : [
          "Move camera 2 feet left for better balance",
          "Lower angle to make building more imposing",
          "Include more foreground for depth",
          "Rotate 15 degrees for aligned columns"
        ]

        toggle : "enable_disable_suggestions"
      }

      interesting_subjects : {
        highlight : "ai_highlights_photogenic_elements"
        examples : [
          "Chariot race in progress",
          "Senator giving speech",
          "Beautiful sunset over Tiber",
          "Dramatic fire in distance"
        ]

        auto_frame : "ai_suggests_perfect_framing_for_subject"
      }
    }
  }

  // ==========================================================================
  // SUBJECT CONTROLS
  // ==========================================================================
  // Control what appears in the photograph

  subjects : {

    citizen_posing : {
      select_citizens : {
        tap : "tap_citizen_to_select"
        multiple : "select_up_to_20_citizens"
      }

      poses : {
        categories : {
          daily_life : ["walking", "talking", "working", "carrying", "resting"]
          formal : ["standing_proud", "saluting", "praying", "speaking"]
          social : ["conversing", "embracing", "celebrating", "dining"]
          action : ["running", "fighting", "cheering", "fleeing"]
          emotion : ["happy", "sad", "angry", "fearful", "surprised"]
        }

        control : {
          pose_library : "browse_hundreds_of_poses"
          apply : "apply_pose_to_selected_citizen"
          blend : "blend_between_two_poses"
          mirror : "flip_pose_left_right"
        }

        custom : {
          save_pose : "save_current_animation_frame_as_custom_pose"
          import : "import_community_created_poses"
        }
      }

      expressions : {
        facial : {
          presets : ["neutral", "smile", "laugh", "frown", "scowl", "fear", "surprise", "contempt"]
          sliders : {
            eyebrows : "raised_to_furrowed"
            eyes : "wide_to_squinting"
            mouth : "smile_to_frown"
          }
        }
      }

      placement : {
        nudge : "fine_position_adjustment_inches"
        rotate : "rotate_citizen_to_face_camera_or_away"
        height : "adjust_if_standing_on_elevation"
      }

      freeze : {
        hold_pose : "citizen_holds_pose_indefinitely"
        release : "return_to_normal_ai_behavior"
      }
    }

    hide_show_elements : {
      ui_elements : {
        hide_all_ui : "completely_clean_screenshot"
        selective : {
          options : ["buttons", "menus", "notifications", "tooltips", "resource_bars"]
          toggle_individual : "show_hide_specific_ui_elements"
        }
      }

      world_elements : {
        buildings : {
          hide_specific : "hide_building_blocking_view"
          show_only : "show_only_specific_buildings"
          filter_by_type : "hide_all_insulae_show_only_monuments"
        }

        citizens : {
          hide_all : "empty_streets_for_architectural_shots"
          density : "reduce_or_increase_visible_citizen_density"
          filter : "show_only_soldiers_or_only_nobles_etc"
        }

        vehicles : {
          hide_carts : "remove_carts_wagons"
          hide_chariots : "remove_chariots"
        }

        nature : {
          trees : "hide_show_vegetation"
          water : "toggle_water_visibility"
        }

        effects : {
          smoke : "hide_show_smoke_from_buildings"
          dust : "hide_show_dust_particles"
          weather : "hide_rain_snow_effects"
        }
      }

      overlays : {
        roads : "hide_show_road_overlays"
        zones : "hide_show_zoning_overlays"
        borders : "hide_show_district_borders"
      }
    }

    lighting_control : {
      note : "see_lighting_section_below"
    }
  }

  // ==========================================================================
  // LIGHTING & TIME OF DAY
  // ==========================================================================
  // Control lighting for perfect illumination

  lighting : {

    time_of_day : {
      control : {
        time_slider : "24_hour_slider_to_set_exact_time"
        quick_presets : ["sunrise", "golden_hour_morning", "noon", "golden_hour_evening", "sunset", "twilight", "midnight"]

        speed : {
          pause : "freeze_time_completely"
          slow : "slow_time_to_see_light_changes"
          normal : "real_time_passage"
          fast : "timelapse_speed"
        }

        animate : {
          enable : "automatically_animate_through_day"
          duration : "10s_30s_1min_for_full_day_cycle"
          loop : "continuous_loop_for_timelapse"
        }
      }

      lighting_conditions : {
        sunrise : {
          time : "6am"
          character : "soft_warm_golden_light_from_east"
          shadows : "long_dramatic_shadows"
          mood : "peaceful_hopeful_new_beginning"
        }

        golden_hour_morning : {
          time : "7_to_8am"
          character : "magical_warm_orange_glow"
          shadows : "still_long_but_softer"
          mood : "romantic_beautiful"
        }

        noon : {
          time : "12pm"
          character : "harsh_bright_white_light_from_above"
          shadows : "short_hard_shadows_directly_below"
          mood : "intense_stark_documentary"
        }

        golden_hour_evening : {
          time : "5_to_6pm"
          character : "warm_golden_amber_light_from_west"
          shadows : "long_stretching_towards_east"
          mood : "romantic_nostalgic_cinematic"
        }

        sunset : {
          time : "6_to_7pm"
          character : "orange_red_purple_hues_dramatic"
          shadows : "very_long_dramatic"
          mood : "epic_emotional_ending"
        }

        twilight : {
          time : "7_to_8pm"
          character : "blue_hour_soft_diffused_blue_light"
          shadows : "minimal_soft"
          mood : "mysterious_peaceful_contemplative"
        }

        night : {
          time : "9pm_to_5am"
          character : "moonlight_artificial_lights_torches"
          shadows : "deep_blacks_pools_of_light"
          mood : "dramatic_mysterious_intimate"
        }
      }
    }

    sun_position : {
      override : {
        enable : "override_realistic_sun_position"
        azimuth : "0_to_360_degrees_horizontal_position"
        elevation : "-10_to_90_degrees_vertical_angle"
      }

      use_cases : {
        backlight : "position_sun_behind_subject_for_rim_light"
        sidelight : "position_sun_to_side_for_dramatic_shadows"
        frontlight : "position_sun_facing_subject_for_even_illumination"
      }

      visualization : {
        sun_path : "show_arc_of_sun_across_sky"
        sun_indicator : "visual_indicator_of_sun_position"
      }
    }

    artificial_lights : {
      torches_lamps : {
        intensity : "adjust_brightness_of_torches_and_oil_lamps"
        color : "warm_orange_flickering_light"
        toggle : "turn_all_on_off_or_selective"
      }

      fire : {
        intensity : "brightness_of_fires_braziers"
        glow : "radius_of_firelight"
      }

      ambient_occlusion : {
        intensity : "darken_crevices_and_corners"
        effect : "increases_depth_and_realism"
      }
    }

    weather_lighting : {
      clear : "bright_direct_sunlight"
      partly_cloudy : "softer_light_with_intermittent_sun"
      overcast : "diffused_flat_light_no_hard_shadows"
      stormy : "dark_dramatic_occasional_lightning"
      fog : "soft_diffused_mysterious_limited_visibility"

      slider : "adjust_cloudiness_0_to_100_percent"
    }

    mood_presets : {
      cinematic : {
        dawn_of_empire : "golden_sunrise_hopeful"
        glory_of_rome : "bright_midday_triumphant"
        twilight_of_gods : "purple_sunset_melancholic"
        fall_of_rome : "dark_stormy_ominous"
      }

      artistic : {
        renaissance_painting : "dramatic_chiaroscuro_lighting"
        impressionist : "soft_dappled_light"
        romantic : "golden_warm_glowing"
        film_noir : "high_contrast_harsh_shadows"
      }
    }

    custom_lights : {
      add_light : {
        type : ["point", "spot", "directional", "area"]
        position : "place_anywhere_in_scene"
        color : "full_rgb_color_picker"
        intensity : "0_to_1000_percent"
        radius : "range_of_light_influence"
      }

      up_to : "10_custom_lights_per_scene"

      use_cases : {
        fill_light : "brighten_shadows_on_subject"
        rim_light : "backlight_for_edge_highlighting"
        accent_light : "highlight_specific_detail"
        atmospheric : "volumetric_god_rays"
      }
    }
  }

  // ==========================================================================
  // POST-PROCESSING & FILTERS
  // ==========================================================================
  // Edit and enhance captured images

  post_processing : {

    color_grading : {
      presets : {
        natural : "realistic_colors_no_grading"
        vibrant : "boosted_saturation_punchy_colors"
        muted : "desaturated_subtle_tones"
        warm : "orange_amber_tones_nostalgic"
        cool : "blue_teal_tones_modern"
        cinematic : "teal_and_orange_hollywood_look"
        vintage : "faded_retro_colors"
        monochrome : "black_and_white"
        sepia : "brown_tones_old_photograph"
        custom : "full_manual_control"
      }

      manual_controls : {
        temperature : {
          range : "warm_to_cool"
          effect : "2000k_to_10000k_color_temperature"
        }

        tint : {
          range : "green_to_magenta"
          effect : "fine_tune_color_balance"
        }

        exposure : {
          range : "-3_to_+3_ev"
          effect : "overall_brightness"
        }

        contrast : {
          range : "-100_to_+100"
          effect : "difference_between_light_and_dark"
        }

        highlights : {
          range : "-100_to_+100"
          effect : "brighten_or_darken_bright_areas"
        }

        shadows : {
          range : "-100_to_+100"
          effect : "brighten_or_darken_dark_areas"
        }

        whites : {
          range : "-100_to_+100"
          effect : "adjust_white_point"
        }

        blacks : {
          range : "-100_to_+100"
          effect : "adjust_black_point"
        }

        saturation : {
          range : "-100_to_+100"
          effect : "intensity_of_all_colors"
        }

        vibrance : {
          range : "-100_to_+100"
          effect : "intensity_of_muted_colors_only"
        }

        clarity : {
          range : "-100_to_+100"
          effect : "midtone_contrast_texture_detail"
        }

        dehaze : {
          range : "0_to_100"
          effect : "remove_atmospheric_haze"
        }
      }

      curves : {
        rgb_curve : "adjust_tonal_curve_for_all_channels"
        red_curve : "adjust_red_channel"
        green_curve : "adjust_green_channel"
        blue_curve : "adjust_blue_channel"

        control_points : "add_points_to_curve_for_precise_control"
      }

      hsl_sliders : {
        hue : "shift_specific_color_hues"
        saturation : "adjust_saturation_of_specific_colors"
        luminance : "adjust_brightness_of_specific_colors"

        channels : ["red", "orange", "yellow", "green", "aqua", "blue", "purple", "magenta"]
      }

      split_toning : {
        highlights_color : "tint_bright_areas_with_color"
        shadows_color : "tint_dark_areas_with_color"
        balance : "blend_between_highlight_and_shadow_toning"
      }
    }

    artistic_filters : {
      oil_painting : {
        effect : "painterly_oil_painting_look"
        brush_size : "small_to_large_brushstrokes"
      }

      watercolor : {
        effect : "soft_flowing_watercolor_painting"
        intensity : "subtle_to_heavy"
      }

      pencil_sketch : {
        effect : "graphite_pencil_drawing"
        detail : "fine_lines_or_broad_strokes"
      }

      ink_drawing : {
        effect : "black_ink_illustration"
        style : "cross_hatch_or_stippling"
      }

      mosaic : {
        effect : "roman_mosaic_tile_effect"
        tile_size : "small_to_large_tiles"
        historically_appropriate : "authentic_roman_mosaic_patterns"
      }

      fresco : {
        effect : "ancient_roman_wall_fresco_look"
        aging : "cracked_faded_weathered"
      }

      engraving : {
        effect : "historical_engraving_style"
        line_density : "fine_to_coarse_lines"
      }

      posterize : {
        effect : "reduced_colors_poster_art"
        levels : "2_to_32_color_levels"
      }
    }

    effects : {
      bloom : {
        intensity : "soft_glow_around_highlights"
        threshold : "brightness_threshold_for_bloom"
        radius : "size_of_glow"
      }

      god_rays : {
        enable : "volumetric_light_shafts"
        intensity : "brightness_of_rays"
        source : "sun_or_custom_light_sources"
      }

      fog : {
        density : "thickness_of_fog"
        color : "white_blue_or_custom"
        height : "ground_fog_or_high_atmosphere"
      }

      rain : {
        intensity : "light_to_heavy_rain"
        droplets_on_lens : "water_droplets_on_camera"
      }

      snow : {
        intensity : "light_flurries_to_blizzard"
        accumulation : "visible_snow_on_surfaces"
      }

      dust_particles : {
        density : "floating_dust_motes_in_air"
        sunbeams : "visible_in_light_shafts"
      }
    }

    sharpening_noise : {
      sharpen : {
